# App
APP_NAME=CHAKRA AI
SECRET_KEY=change-this-secret-key
FLASK_HOST=0.0.0.0
FLASK_PORT=5200
FLASK_DEBUG=true

# Session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_TIMEOUT_HOURS=4
SESSION_REFRESH_EACH_REQUEST=true

# MySQL
MY_SQL_HOST=your-mysql-host.a.aivencloud.com
MY_SQL_PORT=3306
MY_SQL_USER=your_mysql_user
MY_SQL_PASSWORD=your_mysql_password
MY_SQL_DATABASE=your_database_name
MY_SQL_POOL_NAME=mypool
MY_SQL_POOL_SIZE=5

# MySQL SSL / TLS
MY_SQL_SSL_DISABLED=false
MY_SQL_SSL_CA=C:\path\to\ca.pem
MY_SQL_SSL_CERT=
MY_SQL_SSL_KEY=
MY_SQL_SSL_VERIFY_CERT=true
MY_SQL_SSL_VERIFY_IDENTITY=true
MY_SQL_TLS_VERSIONS=TLSv1.2,TLSv1.3

# External APIs
APIS_PERU_TOKEN=your_api_token
APIS_PERU_URL=http://api.decolecta.com

# OCR
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_INPUT_DIR=D:\path\to\input\folder
